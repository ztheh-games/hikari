#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Projection
{
    float2 targetSize;
    float2 padding;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
    float4 in_var_TEXCOORD2 [[attribute(2)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_Projection& Projection [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = float4(((in.in_var_TEXCOORD0.x * 2.0) / Projection.targetSize.x) - 1.0, 1.0 - ((in.in_var_TEXCOORD0.y * 2.0) / Projection.targetSize.y), 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    return out;
}
