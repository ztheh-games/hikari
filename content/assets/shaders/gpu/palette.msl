fragment main0_out main0(main0_in in [[stage_in]], constant type_Palette& Palette [[buffer(0)]], texture2d<float> sourceTexture [[texture(0)]], texture2d<float> paletteTexture [[texture(1)]], sampler sourceSampler [[sampler(0)]], sampler paletteSampler [[sampler(1)]])
{
    main0_out out = {};
    float4 _36 = sourceTexture.sample(sourceSampler, in.in_var_TEXCOORD0);
